<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="jellyfin.exe"
        Arguments=""
        InstallLocation="C:\Program Files\MorenoLand\Jellyfin">
    </Installer>
    <PackageInformation
        PackageName="Jellyfin"
        PackageDisplayName="Jellyfin"
        PublisherName="CN=MorenoLand"
        PublisherDisplayName="MorenoLand"
        Version="0.1.0.0"
        PackageDescription="Jellyfin Desktop Client">
        <Capabilities>
            <Capability Name="runFullTrust" />

        </Capabilities>
        <Applications>
            <Application
                Id="land.moreno.jellyfin"
                Description="Jellyfin Desktop Client"
                DisplayName="Jellyfin"
                ExecutableName="jellyfin.exe"
                EntryPoint="Windows.FullTrustApplication">

            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>Jellyfin</DisplayName>
            <PublisherDisplayName>MorenoLand</PublisherDisplayName>
            <Description>Jellyfin Desktop Client</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="jellyfin.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
